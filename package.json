{
  "name": "sona-docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "audit": "pnpm audit --audit-level moderate",
    "ci:pr": "pnpm lint && pnpm test && pnpm build && pnpm audit --audit-level moderate",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
